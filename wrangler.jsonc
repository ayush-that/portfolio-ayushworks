{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ayushworks",
  "compatibility_date": "2024-12-30",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "ayushworks.com", "custom_domain": true }],
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
}
